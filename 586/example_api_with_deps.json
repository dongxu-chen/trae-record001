{
  "name": "用户搜索接口 - 参数联动测试",
  "url": "https://example.com/api/users/search",
  "method": "GET",
  "param_location": "query",
  "headers": {
    "Content-Type": "application/json",
    "Authorization": "Bearer demo_token"
  },
  "params": [
    {
      "name": "keyword",
      "type": "string",
      "default": "test",
      "required": true,
      "group": "search"
    },
    {
      "name": "page",
      "type": "integer",
      "default": 1,
      "depends_on": ["keyword"],
      "relation": "direct",
      "constraints": {
        "min": 1,
        "max": 100
      }
    },
    {
      "name": "page_size",
      "type": "integer",
      "default": 20,
      "depends_on": ["page"],
      "relation": "direct",
      "constraints": {
        "min": 1,
        "max": 100
      }
    },
    {
      "name": "sort_by",
      "type": "string",
      "default": "created_at",
      "depends_on": ["keyword"],
      "relation": "direct"
    },
    {
      "name": "sort_order",
      "type": "string",
      "default": "desc",
      "depends_on": ["sort_by"],
      "relation": "same"
    }
  ]
}
