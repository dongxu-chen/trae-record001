# Database Configuration
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database

# Slow Query Log Path
SLOW_QUERY_LOG_PATH=/path/to/slow_query.log

# RL Configuration
RL_NUM_EPISODES=500
RL_MAX_STEPS=50
RL_BATCH_SIZE=64
RL_LEARNING_RATE=0.001

# Index Configuration
MAX_INDEXES_PER_TABLE=5
MAX_COLUMNS_PER_INDEX=4
