# 服务配置
PORT=3000
NODE_ENV=development

# MongoDB 配置
MONGODB_URI=mongodb://localhost:27017/message_center

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 邮件配置 (IMAP)
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_TLS=true
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password

# 钉钉配置
DINGTALK_APP_KEY=your_dingtalk_app_key
DINGTALK_APP_SECRET=your_dingtalk_app_secret
DINGTALK_USER_ID=your_dingtalk_user_id

# 企业微信配置
WEWORK_CORP_ID=your_wework_corp_id
WEWORK_AGENT_ID=your_wework_agent_id
WEWORK_SECRET=your_wework_secret
WEWORK_USER_ID=your_wework_user_id

# Slack 配置
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_USER_ID=your_slack_user_id

# 聚合推送配置
AGGREGATION_CRON=0 */30 * * * *
AGGREGATION_ENABLED=true

# 去重配置
DEDUP_WINDOW_MINUTES=30
DEDUP_SIMILARITY_THRESHOLD=0.85
DEDUP_HASH_BITS=64

# 分类配置
CLASSIFICATION_USE_FASTTEXT=true
CLASSIFICATION_MODEL_PATH=
CLASSIFICATION_TRAINING_DATA_PATH=
CLASSIFICATION_MIN_CONFIDENCE=0.3

# 紧急通知配置
URGENT_NOTIFICATION_ENABLED=true
URGENT_COOLDOWN_PERIOD=60000

# AI 摘要配置
AI_SUMMARY_USE_EXTERNAL=false
AI_SUMMARY_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_SUMMARY_API_KEY=your_openai_api_key
AI_SUMMARY_MIN_LENGTH=200
AI_SUMMARY_DEFAULT_LENGTH=100

# 智能提醒配置
REMINDER_ENABLED=true
REMINDER_AUTO_PIN=true

# 模板解析配置
TEMPLATE_ENABLED=true
TEMPLATE_AUTO_PARSE=true
TEMPLATE_MIN_MATCH_SCORE=0.3
