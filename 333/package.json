{
  "name": "clipboard-sync",
  "version": "1.0.0",
  "description": "跨平台剪贴板同步工具 - 支持文本、图片、文件端到端加密同步",
  "main": "dist-electron/main/index.js",
  "author": "Clipboard Sync Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "start:signaling": "node server/signaling-server.js",
    "start:turn": "node server/turn-server.js",
    "install:native": "electron-rebuild -f -w better-sqlite3",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@journeyapps/sqlcipher": "^5.3.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.0",
    "crypto-js": "^4.2.0",
    "electron-store": "^8.1.0",
    "pbkdf2": "^3.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "simple-peer": "^9.11.1",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.11.0",
    "@types/pbkdf2": "^3.1.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/simple-peer": "^9.11.8",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "electron-rebuild": "^3.2.9",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.15.5",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.clipboardsync.app",
    "productName": "Clipboard Sync",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron",
      "server"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
