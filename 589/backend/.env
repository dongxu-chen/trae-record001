# 数据库配置
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/price_comparison?charset=utf8mb4
PRICE_HISTORY_DB_URL=sqlite:///./price_history.db

# Redis配置
REDIS_URL=redis://localhost:6379/0

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=True

# 邮件服务配置（用于降价提醒通知）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_email@qq.com

# 爬虫配置
CRAWLER_DELAY=2
CRAWLER_RETRY_TIMES=3
CRAWLER_CONCURRENT_REQUESTS=16

# 安全配置
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 管理员配置
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
