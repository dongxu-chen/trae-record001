{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "ID Generation QPS (Snowflake)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(distid_snowflake_latency_seconds_count[1m])",
          "legendFormat": "Snowflake QPS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "ID Generation QPS (Segment)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(distid_segment_latency_seconds_count[1m])",
          "legendFormat": "Segment QPS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Snowflake Latency Percentiles (T-Digest)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "distid_snowflake_percentile_p50",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "distid_snowflake_percentile_p90",
          "legendFormat": "P90",
          "refId": "B"
        },
        {
          "expr": "distid_snowflake_percentile_p99",
          "legendFormat": "P99",
          "refId": "C"
        },
        {
          "expr": "distid_snowflake_percentile_p999",
          "legendFormat": "P99.9",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "μs",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Segment Latency Percentiles (T-Digest)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "distid_segment_percentile_p50",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "distid_segment_percentile_p90",
          "legendFormat": "P90",
          "refId": "B"
        },
        {
          "expr": "distid_segment_percentile_p99",
          "legendFormat": "P99",
          "refId": "C"
        },
        {
          "expr": "distid_segment_percentile_p999",
          "legendFormat": "P99.9",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "μs",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(distid_snowflake_errors_total[1m])",
          "legendFormat": "Snowflake Errors/s",
          "refId": "A"
        },
        {
          "expr": "rate(distid_segment_errors_total[1m])",
          "legendFormat": "Segment Errors/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Clock Backward Events",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "distid_snowflake_clock_backward_total",
          "legendFormat": "Clock Backward Count",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "WorkerID Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "count by (worker_id) (distid_snowflake_worker_info)",
          "legendFormat": "Worker {{worker_id}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "NTP Sync Status",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "distid_ntp_offset_ms",
          "legendFormat": "NTP Offset",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "title": "JVM Memory Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"distid-service\"}",
          "legendFormat": "{{area}} - {{id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "JVM GC Pause",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[1m])",
          "legendFormat": "{{action}} - {{cause}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ],
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["distid", "id-generator", "t-digest"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Distributed ID Service Dashboard (T-Digest Enhanced)",
  "uid": "distid-dashboard-v2",
  "version": 2
}
