# FastAPI Settings
APP_NAME=Academic Citation Network Analyzer
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# API Rate Limiting
CROSSREF_RATE_LIMIT=50
DBLP_RATE_LIMIT=100
REQUEST_TIMEOUT=30

# Cache TTL (seconds)
CACHE_TTL_SEARCH=3600
CACHE_TTL_PAPER=86400
CACHE_TTL_GRAPH=1800
