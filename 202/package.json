{
  "name": "file-sync-client",
  "version": "1.0.0",
  "description": "Cross-platform file synchronization client",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build": "electron-builder"
  },
  "keywords": ["electron", "file-sync", "cloud"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "chokidar": "^3.5.3",
    "crypto-js": "^4.2.0",
    "form-data": "^4.0.0"
  },
  "build": {
    "appId": "com.filesync.client",
    "productName": "FileSync Client",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
