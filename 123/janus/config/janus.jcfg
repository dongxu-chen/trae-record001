general: {
	configs_folder = "/usr/local/etc/janus"
	plugins_folder = "/usr/local/lib/janus/plugins"
	transports_folder = "/usr/local/lib/janus/transports"
	events_folder = "/usr/local/lib/janus/events"
	log_to_stdout = true
	debug_level = 4
	debug_timestamps = true
	debug_colors = true
	debug_locks = false
	api_secret = "janus-exam-secret-2024"
	token_auth = false
	server_name = "Janus Exam SFU"
	session_timeout = 60
	recordings_temp_ext = ".tmp"
	protected_folders = [
		"/usr/local/share/janus/recordings/"
	]
}

certificates: {
	cert_pem = "/usr/local/share/janus/certs/mycert.pem"
	cert_key = "/usr/local/share/janus/certs/mycert.key"
}

media: {
	ipv6 = false
	udp_port_range = "10000-10500"
	tcp_port_range = ""
	ice_tcp = false
	ice_lite = false
	ice_keepalive_conncheck = false
	full_trickle = true
	twcc_period = 200
	dtls_timeout = 30
	nack_optimizations = true
	qp_logging = false
	metrics = false
	no_media_timer = 0
	slowlink_threshold = 4
}

nat: {
	stun_server = "stun.l.google.com"
	stun_port = 19302
	nice_debug = false
	full_trickle = true
	ice_enforce_list = "eth0"
}

plugins: {
	disable = "libjanus_sip.so,libjanus_voicemail.so,libjanus_streaming.so,libjanus_textroom.so,libjanus_audiobridge.so"
}

transports: {
	disable = "libjanus_transport_rabbitmq.so,libjanus_transport_mqtt.so,libjanus_transport_nanomsg.so,libjanus_transport_unixsocket.so"
}

events: {
	disable = "libjanus_eventhandler_sample.so"
}

loggers: {
	disable = "libjanus_logger_json.so"
}
