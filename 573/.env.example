API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

TRIVY_PATH=trivy
TRIVY_CACHE_DIR=/tmp/trivy-cache
TRIVY_TIMEOUT=300

TRIVY_DB_AUTO_UPDATE=True
TRIVY_DB_UPDATE_INTERVAL_HOURS=24
TRIVY_DB_DIR=/tmp/trivy-cache/db
TRIVY_OFFLINE_DB_PATH=

MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT=600

SENSITIVE_PATTERNS_FILE=backend/config/sensitive_patterns.yaml
RULES_CONFIG_FILE=backend/config/rules.yaml

SENSITIVE_SCAN_KEYWORDS=True
SENSITIVE_SCAN_FILES=True
SENSITIVE_SCAN_MAX_FILE_SIZE_MB=50

REPORTS_DIR=reports
LOG_LEVEL=INFO

DEFAULT_REPORT_FORMAT=json
JUNIT_REPORT_FAIL_ON_SEVERITY=MEDIUM

DOCKER_SOCKET=unix://var/run/docker.sock

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
