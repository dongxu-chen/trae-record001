<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.payment.reconciliation.mapper.SettlementMonitorMapper">

    <select id="selectByDateRange" resultType="com.payment.reconciliation.entity.SettlementMonitor">
        SELECT * FROM settlement_monitor
        <where>
            <if test="channelCode != null">
                AND channel_code = #{channelCode}
            </if>
            <if test="startDate != null">
                AND settlement_date >= #{startDate}
            </if>
            <if test="endDate != null">
                AND settlement_date &lt;= #{endDate}
            </if>
        </where>
        ORDER BY settlement_date DESC
    </select>

    <select id="selectDelayedSettlements" resultType="com.payment.reconciliation.entity.SettlementMonitor">
        SELECT * FROM settlement_monitor
        WHERE status IN (1, 3)
        <if test="alertLevel != null">
            AND alert_level >= #{alertLevel}
        </if>
        ORDER BY create_time DESC
    </select>

</mapper>
