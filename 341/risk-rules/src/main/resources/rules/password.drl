package com.riskcontrol.rules.password

import com.riskcontrol.common.model.RiskEvent
import com.riskcontrol.common.model.RuleHit
import com.riskcontrol.common.model.RiskAssessmentResult
import com.riskcontrol.common.enums.EventType
import com.riskcontrol.common.enums.RuleType
import java.util.List

function int calculatePasswordStrength(String password) {
    if (password == null || password.length() < 6) return 0;
    int score = 0;
    if (password.length() >= 8) score += 1;
    if (password.length() >= 12) score += 1;
    if (password.matches(".*[a-z].*")) score += 1;
    if (password.matches(".*[A-Z].*")) score += 1;
    if (password.matches(".*[0-9].*")) score += 1;
    if (password.matches(".*[!@#$%^&*(),.?\":{}|<>].*")) score += 1;
    return score;
}

function boolean isCommonPassword(String password) {
    if (password == null) return false;
    String lower = password.toLowerCase();
    java.util.List<String> common = java.util.Arrays.asList(
        "password", "123456", "12345678", "qwerty", "abc123",
        "monkey", "1234567", "letmein", "trustno1", "dragon",
        "password1", "iloveyou", "sunshine", "princess", "admin"
    );
    return common.contains(lower);
}

rule "Weak Password on Registration"
    no-loop true
    salience 85
    when
        $event : RiskEvent(eventType == EventType.REGISTER,
                          newPasswordHash != null)
        $result : RiskAssessmentResult()
        $hitRules : List()
    then
        String pwd = $event.getNewPasswordHash();
        int strength = calculatePasswordStrength(pwd);
        boolean isCommon = isCommonPassword(pwd);
        if (strength < 3 || isCommon) {
            int score = isCommon ? 35 : 25;
            RuleHit hit = RuleHit.builder()
                .ruleId("RULE_PASSWORD_WEAK_001")
                .ruleName("Weak Password")
                .ruleType(RuleType.PASSWORD_PATTERN)
                .score(score)
                .description("Weak or common password used for registration")
                .evidence("Password strength: " + strength + "/6" + (isCommon ? ", Common password" : ""))
                .hitTimestamp(System.currentTimeMillis())
                .build();
            $hitRules.add(hit);
        }
end

rule "Password Change Too Soon"
    no-loop true
    salience 80
    when
        $event : RiskEvent(eventType == EventType.PASSWORD_CHANGE,
                          lastLoginTimestamp > 0,
                          eventTimestamp - lastLoginTimestamp < 60000)
        $result : RiskAssessmentResult()
        $hitRules : List()
    then
        RuleHit hit = RuleHit.builder()
            .ruleId("RULE_PASSWORD_CHANGE_TOO_SOON_001")
            .ruleName("Suspicious Password Change Timing")
            .ruleType(RuleType.PASSWORD_PATTERN)
            .score(30)
            .description("Password change immediately after login")
            .evidence("Time since login: " + ($event.getEventTimestamp() - $event.getLastLoginTimestamp()) + "ms")
            .hitTimestamp(System.currentTimeMillis())
            .build();
        $hitRules.add(hit);
        modify($result) { setRequireMfa(true) };
end

rule "Sensitive Operation Without Recent Login"
    no-loop true
    salience 75
    when
        $event : RiskEvent(eventType == EventType.PASSWORD_CHANGE ||
                          eventType == EventType.EMAIL_CHANGE ||
                          eventType == EventType.PHONE_CHANGE,
                          lastLoginTimestamp > 0,
                          eventTimestamp - lastLoginTimestamp > 3600000)
        $result : RiskAssessmentResult()
        $hitRules : List()
    then
        long hoursSinceLogin = ($event.getEventTimestamp() - $event.getLastLoginTimestamp()) / 3600000;
        RuleHit hit = RuleHit.builder()
            .ruleId("RULE_SENSITIVE_OP_STALE_SESSION_001")
            .ruleName("Sensitive Operation with Stale Session")
            .ruleType(RuleType.PASSWORD_PATTERN)
            .score(20)
            .description("Sensitive operation " + hoursSinceLogin + " hours after login")
            .evidence("Hours since login: " + hoursSinceLogin)
            .hitTimestamp(System.currentTimeMillis())
            .build();
        $hitRules.add(hit);
        modify($result) { setRequireMfa(true) };
end
