FROM golang:1.21-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

WORKDIR /app/backend
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/bin/server .

FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /app

COPY --from=builder /app/bin/server .
COPY config.yaml .

EXPOSE 8080

CMD ["./server"]
