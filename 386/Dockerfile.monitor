FROM eclipse-temurin:17-jre-alpine

LABEL maintainer="gray-release-platform"
LABEL service="monitor-service"

WORKDIR /app

COPY monitor-service/target/monitor-service-1.0.0.jar app.jar

EXPOSE 8082

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget -q --spider http://localhost:8082/monitor-service/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]