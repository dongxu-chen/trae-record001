FROM eclipse-temurin:17-jre-alpine

LABEL maintainer="gray-release-platform"
LABEL service="release-service"

WORKDIR /app

COPY release-service/target/release-service-1.0.0.jar app.jar

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget -q --spider http://localhost:8081/release-service/actuator/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]