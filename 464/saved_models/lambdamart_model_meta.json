    "title_bm25_score",
    "category_match",
    "price_score",
    "sales_volume_norm",
    "click_rate",
    "cart_rate",
    "conversion_rate",
    "ctr_7d",
    "ctr_30d",
    "return_rate",
    "review_score_norm",
    "title_length",
    "query_length",
    "query_title_length_ratio",
    "price_percentile",
    "brand_match",
    "time_decayed_ctr",
