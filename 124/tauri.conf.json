{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../dist",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Clipboard Sync",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "clipboard": {
        "all": true
      },
      "dialog": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": ["$HOME/*", "$DOCUMENT/*", "$DOWNLOAD/*"]
      },
      "notification": {
        "all": true
      },
      "shell": {
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.clipboard.sync",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "category": "Utility",
      "shortDescription": "跨平台剪贴板同步工具",
      "longDescription": "基于Tauri开发的跨平台剪贴板同步工具，支持文本、图片、文件的端到端加密同步"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src *"
    },
    "windows": [
      {
        "title": "Clipboard Sync",
        "width": 1000,
        "height": 750,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
