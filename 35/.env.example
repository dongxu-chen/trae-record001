CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_POOL_SIZE=20
REDIS_RATE_LIMIT_URL=redis://localhost:6379/1

WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=2.0
WEBHOOK_TIMEOUT=10
WEBHOOK_SECRET=your_webhook_signing_secret
WEBHOOK_ALLOWED_DOMAINS=

RATE_LIMIT_DEFAULT_RATE=5
RATE_LIMIT_DEFAULT_CAPACITY=20
RATE_LIMIT_HEADER=X-API-Key

AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=image-processing-bucket
AWS_S3_ENDPOINT_URL=

PORT=5000
