# MongoDB配置
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=price_monitor
MONGO_USER=
MONGO_PASS=

# Redis配置(用于代理池)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASS=

# Flask配置
FLASK_SECRET=change-this-secret-key-in-production

# 邮件告警配置(可选)
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_SENDER=your_email@qq.com
SMTP_PASS=your_email_auth_code
SMTP_RECEIVERS=receiver1@example.com,receiver2@example.com

# Webhook告警配置(可选，如钉钉/飞书)
WEBHOOK_URL=
WEBHOOK_SECRET=