  object sbStatus: TStatusBar
    Left = 0
    Height = 22
    Top = 728
    Width = 1200
    Align = alBottom
    SimplePanel = True
    SimpleText = '就绪'
    Panels = <>
  end
  object dlgOpenDB: TOpenDialog
    Filter = 'SQLite 数据库 (*.db;*.sqlite;*.db3)|*.db;*.sqlite;*.db3|所有文件 (*.*)|*.*'
    DefaultExt = 'db'
    Title = '选择 SQLite 数据库文件'
    Left = 1120
    Top = 8
  end
  object dlgSaveCSV: TSaveDialog
    Filter = 'CSV 文件 (*.csv)|*.csv|所有文件 (*.*)|*.*'
    DefaultExt = 'csv'
    Title = '导出为 CSV 文件'
    Left = 1120
    Top = 40
  end
  object dlgSaveBookmark: TSaveDialog
    Filter = 'SQL 文件 (*.sql)|*.sql|所有文件 (*.*)|*.*'
    DefaultExt = 'sql'
    Title = '保存查询书签'
    Left = 1120
    Top = 72
  end
end
