  Font.Height = -12
  Font.Name = 'Microsoft YaHei UI'
  Font.Style = []
  OnClose = FormClose
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  LCLVersion = '2.2.6.0'
  object pnlTop: TPanel
    Left = 0
