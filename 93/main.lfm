              Left = 8
              Height = 152
              Top = 4
              Width = 970
              Anchors = [akTop, akLeft, akRight, akBottom]
              Caption = 'SQL 查询'
              ClientHeight = 134
              ClientWidth = 966
              TabOrder = 0
              object mmoQuery: TMemo
                Left = 8
                Height = 90
                Top = 8
                Width = 850
                Anchors = [akTop, akLeft, akRight, akBottom]
                Font.Name = 'Consolas'
                Lines.Strings = (
                  'SELECT * FROM '
                )
                ScrollBars = ssBoth
                TabOrder = 0
                WordWrap = False
              end
