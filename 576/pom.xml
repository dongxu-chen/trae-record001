<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.distributed.lock</groupId>
    <artifactId>distributed-lock-monitor</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Distributed Lock Monitor Platform</name>
    <description>分布式锁监控平台 - 监控分布式锁的申请、持有、释放事件</description>

    <modules>
        <module>lock-core</module>
        <module>lock-redis</module>
        <module>lock-zookeeper</module>
        <module>lock-monitor</module>
        <module>lock-analysis</module>
        <module>lock-boot</module>
    </modules>

    <properties>
        <java.version>11</java.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>2.7.18</spring.boot.version>
        <redisson.version>3.24.3</redisson.version>
        <curator.version>5.4.0</curator.version>
        <prometheus.version>1.12.3</prometheus.version>
        <elasticsearch.version>7.17.14</elasticsearch.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.distributed.lock</groupId>
                <artifactId>lock-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.distributed.lock</groupId>
                <artifactId>lock-redis</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <artifactId>lock-zookeeper</artifactId>
                <groupId>com.distributed.lock</groupId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.distributed.lock</groupId>
                <artifactId>lock-monitor</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.distributed.lock</groupId>
                <artifactId>lock-analysis</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>