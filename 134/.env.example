DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=information_schema

AUTO_KILL_ENABLED=false
AUTO_KILL_THRESHOLD_SECONDS=30
AUTO_KILL_EXCLUDE_USERS=root,replication

BINLOG_FORMAT=ROW
ENABLE_BINLOG_PARSING=false

# 慢查询配置
SLOW_QUERY_LOG_PATH=/var/log/mysql/slow.log
SLOW_QUERY_THRESHOLD=1.0

# 钉钉告警配置
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token
DINGTALK_SECRET=your_secret
DINGTALK_AT_MOBILES=13800138000,13900139000

# 机器学习配置
ML_MODEL_PATH=deadlock_prediction_model.pkl
ML_PREDICTION_THRESHOLD=0.7
ML_ENABLE_TRAINING=true

# eBPF配置
EBPF_ENABLED=true
EBPF_BPF_FILE=ebpf_probes.c
EBPF_STATS_INTERVAL=10

# Prometheus指标配置
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9091
