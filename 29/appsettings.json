{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseInMemoryDatabase": true,
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=FileStorageDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "UploadSettings": {
    "UploadPath": "uploads",
    "ChunkPath": "chunks",
    "MaxFileSize": 1073741824,
    "MaxChunkSize": 5242880
  },
  "TokenSettings": {
    "SecretKey": "your-very-secret-key-here-make-it-long-enough-for-security",
    "ExpirationMinutes": 30
  }
}
