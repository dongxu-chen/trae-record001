# Server Configuration
SERVER_PORT=8080

# Nacos Configuration
NACOS_HOST=localhost
NACOS_PORT=8848
NACOS_USER=nacos
NACOS_PASSWORD=nacos

# Database Configuration
DB_PATH=nacos_audit.db

# SMTP Configuration (Email Notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_password
SMTP_FROM=audit@example.com

# Notification Email Recipients (comma separated)
NOTIFY_EMAILS=admin@example.com,manager@example.com

# LDAP Configuration (Responsible Person Lookup)
LDAP_ENABLED=false
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASS=admin
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_FILTER=(cn=%s)
LDAP_EMAIL_ATTR=mail
LDAP_NAME_ATTR=displayName
LDAP_DEPT_ATTR=department
