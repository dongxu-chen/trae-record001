{
  "name": "collaborative-rich-text-editor",
  "version": "1.0.0",
  "description": "Web端富文本协同编辑器 - 支持多人实时编辑、OT算法、Markdown、评论批注",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "sharedb": "^3.3.3",
    "ws": "^8.16.0",
    "rich-text": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "slate": "^0.102.0",
    "slate-react": "^0.102.0",
    "slate-history": "^0.100.0",
    "slate-hyperscript": "^0.100.0",
    "reconnecting-websocket": "^4.4.0",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "date-fns": "^3.3.1",
    "is-hotkey": "^0.2.0",
    "marked": "^12.0.0",
    "turndown": "^7.1.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "docx": "^8.2.4",
    "file-saver": "^2.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.0",
    "nodemon": "^3.0.3",
    "concurrently": "^8.2.2"
  }
}
